// Prisma Schema for Gadi-Sewa
// Nepal's Trusted Vehicle Marketplace

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  firstName     String
  lastName      String
  phone         String?
  avatar        String?
  emailVerified Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  roles         UserRole[]
  vehicles      Vehicle[]
  favorites     Favorite[]
  enquiries     Enquiry[]
  messages      Message[]
  inspections   Inspection[]
  passports     VehiclePassport[]
  notifications Notification[]

  @@map("users")
}

enum Role {
  BUYER
  SELLER
  DEALER_OWNER
  DEALER_EMPLOYEE
  INSPECTOR
  REVIEWER
  ADMIN
}

model UserRole {
  id             String   @id @default(cuid())
  userId         String
  role           Role
  organisationId String?
  createdAt      DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation Organisation? @relation(fields: [organisationId], references: [id], onDelete: SetNull)

  @@unique([userId, role, organisationId])
  @@map("user_roles")
}

model Organisation {
  id          String   @id @default(cuid())
  name        String
  type        OrgType
  address     String?
  phone       String?
  email       String?
  logo        String?
  verified    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roles       UserRole[]
  dealerships Dealership[]

  @@map("organisations")
}

enum OrgType {
  DEALERSHIP
  WORKSHOP
  INSPECTION_SERVICE
}

// ============================================
// VEHICLES & LISTINGS
// ============================================

model Vehicle {
  id              String        @id @default(cuid())
  sellerId        String
  status          ListingStatus @default(DRAFT)
  
  // Basic Info
  category        VehicleCategory
  make            String
  model           String
  variant         String?
  year            Int
  price           Int
  negotiable      Boolean       @default(false)
  
  // Specifications
  mileage         Int?
  fuelType        FuelType?
  transmission    Transmission?
  engineCC        Int?
  batteryCapacity Int?          // For EVs
  range           Int?          // For EVs
  
  // Location
  province        String
  district        String
  city            String
  
  // Details
  description     String?
  condition       VehicleCondition?
  
  // Metadata
  views           Int           @default(0)
  featured        Boolean       @default(false)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  seller          User            @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  images          VehicleImage[]
  favorites       Favorite[]
  enquiries       Enquiry[]
  passport        VehiclePassport?
  inspection      Inspection?

  @@index([status, category])
  @@index([province, district])
  @@index([price])
  @@map("vehicles")
}

enum VehicleCategory {
  CAR
  SUV
  MOTORCYCLE
  SCOOTER
  ELECTRIC_CAR
  ELECTRIC_BIKE
  ELECTRIC_SCOOTER
  VAN
  TRUCK
  BUS
}

enum FuelType {
  PETROL
  DIESEL
  ELECTRIC
  HYBRID
  CNG
  LPG
}

enum Transmission {
  MANUAL
  AUTOMATIC
  CVT
}

enum VehicleCondition {
  NEW
  LIKE_NEW
  EXCELLENT
  VERY_GOOD
  GOOD
  FAIR
  POOR
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  SOLD
  EXPIRED
  REMOVED
}

model VehicleImage {
  id        String   @id @default(cuid())
  vehicleId String
  url       String
  order     Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@map("vehicle_images")
}

// ============================================
// FAVORITES & ENQUIRIES
// ============================================

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  vehicleId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([userId, vehicleId])
  @@map("favorites")
}

model Enquiry {
  id          String        @id @default(cuid())
  vehicleId   String
  buyerId     String
  message     String
  status      EnquiryStatus @default(NEW)
  offerAmount Int?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  buyer   User    @relation(fields: [buyerId], references: [id], onDelete: Cascade)

  @@map("enquiries")
}

enum EnquiryStatus {
  NEW
  READ
  REPLIED
  NEGOTIATING
  CLOSED
}

// ============================================
// MESSAGING
// ============================================

model Conversation {
  id        String   @id @default(cuid())
  vehicleId String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  participants ConversationParticipant[]
  messages     Message[]

  @@map("conversations")
}

model ConversationParticipant {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@map("messages")
}

// ============================================
// VEHICLE PASSPORT & INSPECTIONS
// ============================================

model VehiclePassport {
  id              String          @id @default(cuid())
  vehicleId       String          @unique
  passportNumber  String          @unique
  status          PassportStatus  @default(PENDING)
  
  // Inspection Details
  inspectionDate  DateTime?
  inspectorId     String?
  reviewerId      String?
  
  // Condition Grades
  engineGrade     String?
  bodyGrade       String?
  interiorGrade   String?
  mechanicalGrade String?
  electricalGrade String?
  
  // Findings
  summary         String?
  findings        Json?           // Structured inspection findings
  recommendations String?
  
  // Evidence
  evidencePhotos  String[]        // Array of photo URLs
  documents       String[]        // Array of document URLs
  
  // Verification
  qrCode          String?
  verifiedAt      DateTime?
  
  // Metadata
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  vehicle   Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspector User?      @relation("InspectorPassports", fields: [inspectorId], references: [id])
  reviewer  User?      @relation("ReviewerPassports", fields: [reviewerId], references: [id])

  @@map("vehicle_passports")
}

enum PassportStatus {
  PENDING
  INSPECTION_SCHEDULED
  INSPECTION_IN_PROGRESS
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  EXPIRED
  REVOKED
}

model Inspection {
  id              String             @id @default(cuid())
  vehicleId       String             @unique
  requestId       String?
  inspectorId     String?
  status          InspectionStatus   @default(REQUESTED)
  
  // Inspection Details
  scheduledDate   DateTime?
  completedDate   DateTime?
  location        String?
  
  // Checklist Results
  checklist       Json?              // Structured checklist data
  
  // Findings
  findings        String?
  defects         Json?              // Array of defects found
  recommendations String?
  
  // Evidence
  photos          String[]           // Array of photo URLs
  odometerPhoto   String?
  chassisPhoto    String?
  
  // Metadata
  notes           String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  vehicle   Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  inspector User?   @relation(fields: [inspectorId], references: [id])

  @@map("inspections")
}

enum InspectionStatus {
  REQUESTED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// ============================================
// DEALERSHIPS
// ============================================

model Dealership {
  id             String   @id @default(cuid())
  organisationId String
  name           String
  address        String
  phone          String?
  email          String?
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organisation Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@map("dealerships")
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  read      Boolean  @default(false)
  data      Json?    // Additional data (e.g., vehicleId, enquiryId)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@map("notifications")
}

enum NotificationType {
  ENQUIRY_RECEIVED
  ENQUIRY_REPLIED
  MESSAGE_RECEIVED
  FAVORITE_PRICE_DROP
  PASSPORT_READY
  INSPECTION_SCHEDULED
  LISTING_APPROVED
  LISTING_EXPIRING
  SYSTEM
}
